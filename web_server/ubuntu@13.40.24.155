#!/usr/bin/env bash
# Install and configure Nginx custom 404 page

apt-get update -y
apt-get install -y nginx

echo "Ceci n'est pas une page" > /var/www/html/404.html

sed -i '/server_name _;/a\        error_page 404 /404.html;\n        location = /404.html { internal; }' /etc/nginx/sites-available/default

nginx -t && service nginx restart
